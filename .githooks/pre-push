#!/bin/sh
set -eu

zero_oid=0000000000000000000000000000000000000000

while read -r local_ref local_oid remote_ref remote_oid
do
    if [ "$local_oid" = "$zero_oid" ]
    then
        continue
    fi

    if git log "$local_oid" --format='%ae%n%ce' |
        grep -Ev '^([^[:space:]@]+@users\.noreply\.github\.com|noreply@github\.com)$' |
        grep -q .
    then
        echo "Push blocked: $local_ref contains a commit with a non-noreply author or committer email." >&2
        exit 1
    fi
done
