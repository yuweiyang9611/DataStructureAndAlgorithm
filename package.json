{
  "name": "data-structure-and-algorithm-learning-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:dev": "npm run docs:source && vitepress dev docs --host 127.0.0.1",
    "docs:traces": "node tools/generate_site_traces.mjs",
    "docs:runtime": "node tools/build_browser_runtime.mjs",
    "docs:check-runtime": "node tools/check_browser_runtime.mjs",
    "docs:source": "node tools/bundle_site_source.mjs",
    "docs:build": "npm run docs:check-runtime && npm run docs:source && vitepress build docs && npm run docs:check-render",
    "docs:check-render": "node tools/check_site_rendering.mjs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:test": "node --test tests/site/*.test.ts",
    "docs:typecheck": "vue-tsc --noEmit",
    "docs:test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.8",
    "typescript": "6.0.3",
    "vitepress": "2.0.0-alpha.21",
    "vue-tsc": "3.3.14"
  }
}
