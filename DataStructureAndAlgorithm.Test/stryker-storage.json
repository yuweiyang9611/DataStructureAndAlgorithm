{
  "stryker-config": {
    "project": "DataStructureAndAlgorithm.Scenarios.MiniStorage.csproj",
    "configuration": "Release",
    "target-framework": "net10.0",
    "mutation-level": "Basic",
    "concurrency": 4,
    "mutate": [
      "**/MiniStorageEngine.cs",
      "**/WriteAheadLog.cs",
      "**/StorageSnapshot.cs",
      "**/PersistenceCodec.cs"
    ],
    "reporters": [
      "progress",
      "html",
      "markdown",
      "json"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    }
  }
}
