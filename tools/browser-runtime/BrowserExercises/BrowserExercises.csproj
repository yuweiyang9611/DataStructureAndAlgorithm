<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    The browser host: .NET on WebAssembly exporting BrowserCompiler.AddReference / LoadAssembly /
    Compile / Execute to compiler-worker.js. Vendored from the C# design patterns site
    (tools/BrowserExercises) for the algorithms course. The course library and the four scenario
    assemblies are not referenced here: tools/build_browser_runtime.mjs builds them and serves them
    under refs/, where the worker gives them to Roslyn as references and to the runtime as assemblies.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmBuildNative>false</WasmBuildNative>
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      No lock file for the host. Its only package of its own is Microsoft.NET.Sdk.WebAssembly.Pack, which
      the SDK adds at the version of the installed wasm workload, so a lock entry for it broke every
      restore after a .NET patch release (NU1004) and on any machine whose workload differed. Roslyn is
      still locked: ExerciseEngine and DemoCheck keep their lock files, and build_browser_runtime.mjs
      restores in locked mode. Packages for the host belong in ExerciseEngine; the build script refuses
      a PackageReference here.
    -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../ExerciseEngine/ExerciseEngine.csproj" /></ItemGroup>
  <Target Name="ExportCompilerReferences" AfterTargets="Build">
    <ItemGroup><CompilerReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Microsoft.NETCore.App.Ref'" /></ItemGroup>
    <Copy SourceFiles="@(CompilerReference)" DestinationFolder="$(OutputPath)compiler-refs" />
  </Target>
</Project>
